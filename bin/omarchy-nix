#!/bin/bash
# omarchy-nix — install big desktop apps from nixpkgs on Omarchy.
#
# Arch (and the AUR) carry a lot less for anything that is not x86_64, and the
# gap is worst exactly where it hurts: large GUI applications. nixpkgs builds
# those for every system it supports and cache.nixos.org has them prebuilt, so
# this pulls them into a per-user Nix profile and leaves the base system to
# pacman.
#
# Nothing here is aarch64-specific. The system is read from uname once, and the
# catalogue, the package list, the platform check and the known-impossible list
# are all answered for that system.
#
# Part of the dz0ny.nix-apps Omarchy plugin.

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(dirname "$(dirname "$SELF")")"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-nix"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-nix"
CONFIG_FILE="$CONFIG_DIR/config"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env.d/50-omarchy-nix-apps.sh"

# shellcheck disable=SC1090
[[ -r $CONFIG_FILE ]] && source "$CONFIG_FILE"

CATALOG="${NIX_APPS_CATALOG:-$PLUGIN_DIR/apps.json}"
INDEX_FILE="$STATE_DIR/nixpkgs-index.tsv"
# The graphics driver lives in its own profile: a gcroot that never shows up
# among the apps you installed.
GL_PROFILE="$STATE_DIR/gl"
GL_ENV_FILE="$STATE_DIR/gl-env"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
UPDATES_FILE="$STATE_DIR/updates.json"
# How stale the update check may get before the next --brief recomputes it.
UPDATE_MAX_AGE="${NIX_APPS_UPDATE_MAX_AGE:-21600}"
# How stale the searchable nixpkgs index may get, in seconds.
INDEX_MAX_AGE="${NIX_APPS_INDEX_MAX_AGE:-604800}"
FLAKE="${NIX_APPS_FLAKE:-nixpkgs}"
ALLOW_UNFREE="${NIX_APPS_ALLOW_UNFREE:-1}"
INSTALLER_URL="${NIX_APPS_INSTALLER_URL:-https://install.determinate.systems/nix}"

# uname and nixpkgs mostly agree on machine names; the ones below are where
# they do not. Anything else falls through as <machine>-linux, which is right
# for i686, armv7l, riscv64 and friends.
case "$(uname -m)" in
  aarch64 | arm64) SYSTEM="aarch64-linux" ;;
  x86_64 | amd64) SYSTEM="x86_64-linux" ;;
  ppc64le) SYSTEM="powerpc64le-linux" ;;
  ppc64) SYSTEM="powerpc64-linux" ;;
  *) SYSTEM="$(uname -m)-linux" ;;
esac

# ------------------------------------------------------------------ output

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""
fi

info() { printf '%s\n' "${C_BLUE}==>${C_RESET} $*"; }
ok() { printf '%s\n' "${C_GREEN}  ✓${C_RESET} $*"; }
warn() { printf '%s\n' "${C_YELLOW}  !${C_RESET} $*" >&2; }
bad() { printf '%s\n' "${C_RED}  ✗${C_RESET} $*" >&2; }
die() { printf '%s\n' "${C_RED}omarchy-nix:${C_RESET} $*" >&2; exit 1; }
notify() { command -v omarchy-notification-send >/dev/null 2>&1 && omarchy-notification-send "$@" >/dev/null 2>&1 || true; }
# Nudge the bar widget to re-read the cache, so it disappears the moment the
# last update is taken rather than at the next poll an hour later.
notify_widget() { command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell -q dz0ny.nix-apps refresh >/dev/null 2>&1 || true; }
interactive() { [[ -t 0 && -t 1 ]]; }

# nf-md-nix, spelled out so the glyph survives any editor or transport.
GLYPH=$'\U000F1105'

confirm() {
  interactive || return 0
  if command -v gum >/dev/null 2>&1; then gum confirm "$1"; else
    read -r -p "$1 [y/N] " reply
    [[ $reply == [yY]* ]]
  fi
}

# -------------------------------------------------------------------- nix

NIX=""

find_nix() {
  [[ -n $NIX ]] && return 0
  local candidate
  for candidate in "$(type -P nix || true)" \
    /nix/var/nix/profiles/default/bin/nix \
    "$HOME/.nix-profile/bin/nix"; do
    if [[ -n $candidate && -x $candidate ]]; then
      NIX="$candidate"
      return 0
    fi
  done
  return 1
}

require_nix() {
  find_nix || die "Nix is not installed. Run: omarchy-nix setup"
  # Child processes (and anything nix shells out to) should see the profile.
  case ":$PATH:" in
    *":$HOME/.nix-profile/bin:"*) ;;
    *) PATH="$PATH:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin" ;;
  esac
  export PATH
  # The Determinate installer exports this from /etc/profile.d, which a
  # graphical session never sources; without it TLS to the cache fails.
  if [[ -z ${NIX_SSL_CERT_FILE:-} && -r /etc/ssl/certs/ca-certificates.crt ]]; then
    export NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
  fi
}

nixrun() {
  "$NIX" --extra-experimental-features "nix-command flakes" "$@"
}

# ---------------------------------------------------------------- catalog

valid_attr() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }

# id \t name \t attr \t unfree \t arch-package \t note
resolve_app() {
  local query="$1" row
  row=$(jq -r --arg q "$query" '
    [ .apps[] | select(
        .id == $q
        or .attr == $q
        or ((.name | ascii_downcase) == ($q | ascii_downcase))
      ) ][0]
    | select(. != null)
    | [.id, .name, .attr, ((.unfree // false) | tostring), (.arch // ""), (.note // "")]
    | @tsv' "$CATALOG" 2>/dev/null)

  if [[ -n $row ]]; then
    printf '%s\n' "$row"
    return 0
  fi

  # Not in the catalogue: treat the argument as a bare nixpkgs attribute.
  local attr="${query#*#}"
  valid_attr "$attr" || return 1
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$attr" "$attr" "$attr" "false" "" ""
}

in_catalog() {
  jq -e --arg q "$1" '
    [ .apps[] | select(
        .id == $q
        or .attr == $q
        or ((.name | ascii_downcase) == ($q | ascii_downcase))
      ) ] | length > 0' "$CATALOG" >/dev/null 2>&1
}

# The known-impossible list is not a property of the app, it is a property of
# the app *on this machine*: Spotify and Slack are perfectly installable on
# x86_64. `.unavailable.systems` says where the list applies, and on anything
# else it says nothing at all.
unavailable_here() {
  jq -e --arg s "$SYSTEM" '
    (.unavailable.systems // ["aarch64-linux"]) | index($s) != null' "$CATALOG" >/dev/null 2>&1
}

unavailable_note() {
  unavailable_here || return 0
  jq -r --arg q "$1" '
    [ .unavailable.entries[]? | select((.name | ascii_downcase) | startswith($q | ascii_downcase)) ][0]
    | select(. != null)
    | "\(.name): \(.why). Try instead: \(.instead)"' "$CATALOG" 2>/dev/null
}

native_package() {
  # True when pacman can serve this app from the repos for *this* architecture,
  # in which case Nix is the wrong tool.
  local pkg="$1"
  [[ -n $pkg ]] || return 1
  pacman -Si "$pkg" &>/dev/null
}

# ------------------------------------------------------- nixpkgs metadata

nix_expr_pkgs() {
  printf 'import (builtins.getFlake "%s") { system = "%s"; config.allowUnfree = %s; }' \
    "$FLAKE" "$SYSTEM" "$([[ $ALLOW_UNFREE == 1 ]] && echo true || echo false)"
}

# Classifies one attribute path, as a Nix function named `check`.
#
# The obvious version — tryEval the value, call a failure "missing" — cannot
# tell an attribute that was deleted from one that is still there and throws.
# nixpkgs uses the second for a rename or a discontinuation, and the throw
# carries the answer:
#
#   jetbrains.idea-community: IntelliJ IDEA Community has been removed as it
#   has been discontinued by JetBrains. Either switch to 'jetbrains.idea-oss'
#   or 'jetbrains.idea'.
#
# Reporting that as "attr gone from nixpkgs" sends you looking for a package
# that is sitting right there. So existence is tested with hasAttr, which
# does not force the value, before anything is evaluated.
nix_expr_check() {
  cat <<'NIXEOF'
      exists = path:
        let
          go = attrs: ps:
            if !(builtins.isAttrs attrs) then false
            else let h = builtins.head ps; t = builtins.tail ps;
              in if !(builtins.hasAttr h attrs) then false
                 else if t == [] then true
                 else let probe = builtins.tryEval attrs.${h};
                   in probe.success && go probe.value t;
        in go pkgs (lib.splitString "." path);
      check = path:
        if !(exists path) then "missing"
        else let probe = builtins.tryEval (lib.attrByPath (lib.splitString "." path) null pkgs);
          in if !probe.success then "error"
             else if probe.value == null then "missing"
             else if builtins.elem SYSTEM (probe.value.meta.platforms or []) then "ok"
             else "unsupported";
NIXEOF
}

# Prints "ok", "unsupported", "error", "missing" or "unknown" for one
# attribute path. "error" means it is there but will not evaluate here;
# attr_error prints what nixpkgs said about that.
attr_state() {
  local attr="$1" out
  valid_attr "$attr" || { echo "missing"; return; }
  out=$(nixrun eval --impure --raw --expr "
    let
      pkgs = $(nix_expr_pkgs);
      lib = pkgs.lib;
      SYSTEM = \"$SYSTEM\";
$(nix_expr_check)
    in check \"$attr\"
  " 2>/dev/null)
  printf '%s\n' "${out:-unknown}"
}

# nixpkgs puts the answer in the throw — a rename, a discontinuation, the
# attribute to use instead — so when an attribute refuses to evaluate, ask it
# again without tryEval and keep what it said.
attr_error() {
  local attr="$1"
  nixrun eval --impure --raw --expr "
    let pkgs = $(nix_expr_pkgs);
    in toString (pkgs.lib.attrByPath (pkgs.lib.splitString \".\" \"$attr\") null pkgs).name
  " 2>&1 >/dev/null |
    sed -n 's/^[[:space:]]*error:[[:space:]]*//p' | grep -v '^$' | tail -1
}

# --------------------------------------------------------------- profile

# element-name \t attrPath \t flake-url
profile_rows() {
  nixrun profile list --json 2>/dev/null | jq -r '
    (.elements // {}) as $e
    | if ($e | type) == "object"
      then ($e | to_entries[] | [.key, (.value.attrPath // ""), (.value.originalUrl // .value.url // "")])
      else ($e | to_entries[] | [(.key | tostring), (.value.attrPath // ""), (.value.originalUrl // .value.url // "")])
      end
    | @tsv'
}

# element-name \t attrPath \t comma-joined store paths
profile_rows_detailed() {
  nixrun profile list --json 2>/dev/null | jq -r '
    (.elements // {}) as $e
    | if ($e | type) == "object"
      then ($e | to_entries[] | [.key, (.value.attrPath // ""), ((.value.storePaths // []) | join(","))])
      else ($e | to_entries[] | [(.key | tostring), (.value.attrPath // ""), ((.value.storePaths // []) | join(","))])
      end
    | @tsv'
}

# nix records an element as legacyPackages.<system>.<attr>; everything else in
# here speaks the bare attribute.
strip_attr_prefix() {
  local path="$1"
  path="${path#legacyPackages."$SYSTEM".}"
  path="${path#packages."$SYSTEM".}"
  printf '%s\n' "$path"
}

installed_attr() {
  # Element selector for an attribute, or empty when it is not installed.
  local attr="$1" name path
  while IFS=$'\t' read -r name path _; do
    [[ -z $name ]] && continue
    if [[ $path == "$attr" || $path == *".$attr" || $name == "${attr##*.}" ]]; then
      printf '%s\n' "$name"
      return 0
    fi
  done < <(profile_rows)
  return 1
}

# --------------------------------------------------------------- graphics

# A nixpkgs GUI app ships libglvnd but no driver. On NixOS the driver comes
# from /run/opengl-driver; on Arch that path does not exist, libglvnd finds no
# EGL vendor, and the app dies at startup with
#
#   No provider of eglGetPlatformDisplayEXT found. Requires one of:
#       EGL_EXT_platform_base
#
# The host's mesa cannot fill the gap: it is built against a newer glibc than
# the one in the app's closure, and putting /usr/lib on LD_LIBRARY_PATH takes
# down the whole process — the wrapper shell included, with SIGBUS.
#
# So the driver comes from nixpkgs too, in a profile of its own: a gcroot, and
# out of the way of `omarchy-nix list`. It is applied per app and never
# session-wide, because forcing this mesa on the pacman-managed desktop would
# put Hyprland's own EGL at risk, and losing the compositor costs more than a
# GUI app that will not start.
gl_vendor_json() { printf '%s\n' "$GL_PROFILE/share/glvnd/egl_vendor.d/50_mesa.json"; }

gl_ready() { [[ -r $(gl_vendor_json) ]]; }

gl_complete() { gl_ready && [[ -x $GL_PROFILE/bin/eglinfo ]]; }

ensure_gl() {
  gl_complete && return 0
  require_nix
  info "Installing a nixpkgs mesa for Nix apps to render with"
  mkdir -p "$STATE_DIR"
  # mesa-demos rides along for eglinfo, which is how gl_probe below finds out
  # what this machine can actually give a GTK app.
  #
  # One package at a time, and failures ignored: adding one the profile
  # already holds is an error, and that is exactly the case on a repair run.
  # `add` is the current spelling; `install` is its deprecated alias, kept for
  # a nix older than the one setup installs.
  local pkg
  for pkg in mesa mesa-demos; do
    nixrun profile add --profile "$GL_PROFILE" "$FLAKE#$pkg" >/dev/null 2>&1 ||
      nixrun profile install --profile "$GL_PROFILE" "$FLAKE#$pkg" >/dev/null 2>&1 || true
  done
  if gl_ready; then
    ok "Graphics driver: $GL_PROFILE"
    gl_probe
  else
    bad "could not install mesa from $FLAKE — GUI apps may not start"
    return 1
  fi
}

# Hardware or software, decided once and remembered.
#
# A driver can answer eglInitialize and still be useless to a GTK app: virgl
# in a VM exposes OpenGL 2.1 on the Wayland platform and no core profile at
# all, GTK needs a 3.2 core context, so it fails to make one and the window
# comes up black — the app is running, it just has nothing to draw with. The
# same machine's llvmpipe reports 4.6. So when the hardware path cannot meet
# the bar, stop using it.
#
# Probed rather than assumed, because on a real GPU the answer is the other
# way round and software rendering would be a bad trade. Written to a file
# because asking costs a process and a round-trip to the compositor, and the
# answer only changes when the driver does.
gl_probe() {
  gl_ready || return 1
  mkdir -p "$STATE_DIR"

  case "${NIX_APPS_GL_SOFTWARE:-}" in
    1) printf '# forced by NIX_APPS_GL_SOFTWARE=1\nLIBGL_ALWAYS_SOFTWARE=1\n' >"$GL_ENV_FILE"
       ok "Rendering: software (forced)"; return 0 ;;
    0) printf '# forced by NIX_APPS_GL_SOFTWARE=0\n' >"$GL_ENV_FILE"
       ok "Rendering: hardware (forced)"; return 0 ;;
  esac

  local eglinfo="$GL_PROFILE/bin/eglinfo"
  if [[ ! -x $eglinfo ]]; then
    printf '# no eglinfo to probe with; assuming hardware\n' >"$GL_ENV_FILE"
    return 0
  fi

  # The platform the apps will actually use, not whichever one eglinfo lists
  # first — they do not answer the same.
  local platform="Wayland platform:"
  [[ -n ${WAYLAND_DISPLAY:-} ]] || platform="X11 platform:"

  local core vendor
  vendor=$(gl_vendor_json)
  core=$(__EGL_VENDOR_LIBRARY_FILENAMES="$vendor" LIBGL_DRIVERS_PATH="$GL_PROFILE/lib/dri" \
    "$eglinfo" -B 2>/dev/null |
    awk -v want="$platform" '
      /platform:$/ { inside = (index($0, want) == 1) }
      inside && /OpenGL core profile version:/ { sub(/^[^:]*:[[:space:]]*/, ""); print $1; exit }')

  local num=0
  [[ $core =~ ^([0-9]+)\.([0-9]+) ]] && num=$((BASH_REMATCH[1] * 10 + BASH_REMATCH[2]))

  if ((num >= 32)); then
    printf '# %s core profile %s — hardware\n' "${platform%% *}" "$core" >"$GL_ENV_FILE"
    ok "Rendering: hardware, OpenGL $core"
  else
    printf '# %s offers no OpenGL 3.2 core context — software\nLIBGL_ALWAYS_SOFTWARE=1\n' \
      "${platform%% *}" >"$GL_ENV_FILE"
    warn "this machine's driver offers no OpenGL 3.2 core context on ${platform%% *};"
    warn "using software rendering, or GTK apps come up black"
  fi
}

cmd_gl() {
  case "${1:-}" in
    --refresh)
      ensure_gl || return 1
      info "Updating the graphics driver"
      nixrun profile upgrade --profile "$GL_PROFILE" --all 2>/dev/null || true
      gl_ready && ok "Graphics driver: $(readlink -f "$GL_PROFILE")"
      gl_probe
      ;;
    --probe) gl_probe ;;
    -h | --help) echo "Usage: omarchy-nix gl [--refresh] [--probe]" ;;
    *)
      ensure_gl || return 1
      printf '%s\n' "$(gl_env)"
      ;;
  esac
}

# The environment a Nix GUI app needs, as KEY=VALUE lines. Empty when the
# driver profile is not there, so callers degrade to "try it and see".
gl_env() {
  gl_ready || return 0
  printf '%s\n' \
    "__EGL_VENDOR_LIBRARY_FILENAMES=$(gl_vendor_json)" \
    "LIBGL_DRIVERS_PATH=$GL_PROFILE/lib/dri" \
    "LIBVA_DRIVERS_PATH=$GL_PROFILE/lib/dri"
}

# What the mirrored .desktop files run, and what you use by hand when an app
# started from a terminal cannot find a driver.
cmd_exec() {
  (($#)) || die "usage: omarchy-nix exec <command> [args...]"
  if gl_ready; then
    local vendor
    vendor=$(gl_vendor_json)
    export __EGL_VENDOR_LIBRARY_FILENAMES="$vendor"
    export LIBGL_DRIVERS_PATH="$GL_PROFILE/lib/dri"
    export LIBVA_DRIVERS_PATH="$GL_PROFILE/lib/dri"
    # Plus whatever gl_probe decided. Read as KEY=VALUE rather than sourced:
    # this file is ours, and it stays data.
    local key value
    while IFS='=' read -r key value; do
      export "$key=$value"
    done < <(grep -E '^[A-Z][A-Z0-9_]*=' "$GL_ENV_FILE" 2>/dev/null)
  fi
  exec "$@"
}

# -------------------------------------------------------- desktop entries

# Two problems, one answer.
#
# The launcher watches the applications directories that existed when it
# started. ~/.nix-profile/share/applications is a symlink into the store, and
# every install builds a new generation, so that directory is *replaced*
# rather than modified: no inotify event fires, the watch is left on a store
# path nothing points at any more, and a newly installed app stays invisible
# until the shell restarts. ~/.local/share/applications is a real directory
# that already exists and is already watched.
#
# And the GL wiring above has to be attached per app, which means owning the
# Exec line.
#
# So every Nix .desktop is mirrored here under the same name. Same desktop
# file id, and XDG_DATA_HOME is searched before XDG_DATA_DIRS, so this
# replaces the profile's copy in the launcher rather than doubling it.
sync_desktop_entries() {
  local src="$HOME/.nix-profile/share/applications"
  local f base changed=0
  mkdir -p "$DESKTOP_DIR"

  # Drop the ones we wrote for apps that are no longer installed.
  for f in "$DESKTOP_DIR"/*.desktop; do
    [[ -f $f ]] || continue
    grep -q '^X-Omarchy-Nix=true$' "$f" 2>/dev/null || continue
    base="${f##*/}"
    if [[ ! -f $src/$base ]]; then
      rm -f "$f"
      changed=1
    fi
  done

  if [[ -d $src ]]; then
    local tmp
    for f in "$src"/*.desktop; do
      [[ -f $f ]] || continue
      base="${f##*/}"
      tmp=$(mktemp)
      awk '
        /^\[Desktop Entry\]/ { print; print "X-Omarchy-Nix=true"; next }
        /^Exec[[:space:]]*=/ { sub(/^Exec[[:space:]]*=[[:space:]]*/, "Exec=omarchy-nix exec "); print; next }
        { print }
      ' "$f" >"$tmp"
      if ! cmp -s "$tmp" "$DESKTOP_DIR/$base" 2>/dev/null; then
        mv "$tmp" "$DESKTOP_DIR/$base"
        chmod 644 "$DESKTOP_DIR/$base"
        changed=1
      else
        rm -f "$tmp"
      fi
    done
  fi

  ((changed)) || return 0
  command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1
  return 0
}

refresh_desktop_db() {
  sync_desktop_entries
  return 0
}

# ------------------------------------------------------------------ setup

write_env_file() {
  mkdir -p "$(dirname "$ENV_FILE")"
  cat >"$ENV_FILE" <<'ENV_EOF'
# Managed by omarchy-nix (Omarchy plugin dz0ny.nix-apps).
# Regenerate with: omarchy-nix setup --env-only
#
# uwsm sources every file in ~/.config/uwsm/env.d before starting Hyprland, so
# this is what puts Nix-installed .desktop files, icons and binaries in front
# of the whole graphical session — the app launcher and omarchy-shell included.
# /etc/profile.d/nix.sh only ever reaches login shells, which is why it is not
# enough on its own.

if [ -d "$HOME/.nix-profile/share" ]; then
  XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  case ":$XDG_DATA_DIRS:" in
    *":$HOME/.nix-profile/share:"*) ;;
    *) XDG_DATA_DIRS="$XDG_DATA_DIRS:$HOME/.nix-profile/share:/nix/var/nix/profiles/default/share" ;;
  esac
  export XDG_DATA_DIRS
fi

# Appended, not prepended: a Nix profile that happens to contain git or bash
# should not quietly displace the pacman-managed system tooling.
if [ -d "$HOME/.nix-profile/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.nix-profile/bin:"*) ;;
    *) PATH="$PATH:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin" ;;
  esac
  export PATH
fi

if [ -z "${NIX_SSL_CERT_FILE:-}" ] && [ -r /etc/ssl/certs/ca-certificates.crt ]; then
  export NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
fi
ENV_EOF
  ok "Session environment: $ENV_FILE"
}

write_config_file() {
  [[ -f $CONFIG_FILE ]] && return 0
  mkdir -p "$CONFIG_DIR"
  cat >"$CONFIG_FILE" <<'CONF_EOF'
# omarchy-nix configuration. Sourced by every omarchy-nix invocation.

# Which flake apps come from. "nixpkgs" follows the registry (unstable).
# Pin it for reproducibility, e.g.:
#   NIX_APPS_FLAKE="github:NixOS/nixpkgs/nixos-unstable"
NIX_APPS_FLAKE="nixpkgs"

# Allow unfree packages (VS Code, Obsidian, Sublime, Brave...). Set to 0 to
# refuse them.
NIX_APPS_ALLOW_UNFREE=1

# Path to an alternative app catalogue.
# NIX_APPS_CATALOG="$HOME/.config/omarchy-nix/apps.json"
CONF_EOF
  ok "Config: $CONFIG_FILE"
}

cmd_setup() {
  local env_only=0
  while (($#)); do
    case "$1" in
      --env-only) env_only=1; shift ;;
      -h | --help) echo "Usage: omarchy-nix setup [--env-only]"; return 0 ;;
      *) die "unknown setup option: $1" ;;
    esac
  done

  mkdir -p "$STATE_DIR"

  if ((env_only)); then
    write_env_file
    write_config_file
    return 0
  fi

  if find_nix; then
    ok "Nix already installed: $NIX"
  else
    info "Installing Determinate Nix"
    cat <<EOS

  This installs Nix system-wide with the Determinate Systems installer:

      curl -sSf -L $INSTALLER_URL | sh -s -- install --determinate --no-confirm

  It creates /nix, adds a nix-daemon service and a build group, and can be
  reverted at any time with:  /nix/nix-installer uninstall
  It needs sudo, so expect a password prompt.

EOS
    confirm "Install Determinate Nix now?" || die "aborted"

    curl --proto '=https' --tlsv1.2 -sSf -L "$INSTALLER_URL" |
      sh -s -- install --determinate --no-confirm || die "the Nix installer failed"

    find_nix || die "Nix installed but no nix binary was found on disk"
    ok "Nix installed: $NIX"
  fi

  write_config_file
  write_env_file

  require_nix
  info "Nix version: $(nixrun --version 2>/dev/null | head -1)"
  ensure_gl || true

  cat <<EOS

  ${C_BOLD}Next:${C_RESET}
    omarchy-nix menu          pick apps to install
    omarchy-nix install code  install one by catalogue id
    omarchy-nix doctor        check the integration

  Log out and back in once, so the session picks up XDG_DATA_DIRS and the
  installed apps show up in the Omarchy launcher.

EOS
}

# ---------------------------------------------------------------- install

cmd_install() {
  local force=0 skip_check=0 targets=()
  while (($#)); do
    case "$1" in
      -f | --force) force=1; shift ;;
      --no-check) skip_check=1; shift ;;
      -h | --help)
        echo "Usage: omarchy-nix install [--force] [--no-check] <app|nixpkgs-attr>..."
        return 0
        ;;
      -*) die "unknown install option: $1" ;;
      *) targets+=("$1"); shift ;;
    esac
  done
  ((${#targets[@]})) || die "nothing to install (try: omarchy-nix menu)"

  require_nix

  local refs=() labels=() target row id name attr unfree arch note state selector hint
  for target in "${targets[@]}"; do
    # Ask about the known-impossible list before falling back to treating the
    # argument as a bare attribute, so "spotify" explains itself instead of
    # failing later with a nixpkgs evaluation error.
    if ((!force)) && ! in_catalog "$target"; then
      hint=$(unavailable_note "$target")
      if [[ -n $hint ]]; then
        warn "$hint"
        continue
      fi
    fi

    if ! row=$(resolve_app "$target"); then
      bad "unknown app: $target"
      continue
    fi
    IFS=$'\t' read -r id name attr unfree arch note <<<"$row"

    if selector=$(installed_attr "$attr"); then
      ok "$name is already installed ($selector)"
      continue
    fi

    if ((!force)) && native_package "$arch"; then
      warn "$name is in the Arch repos for this machine as '$arch'."
      warn "Prefer: omarchy pkg add $arch   (use --force to install from Nix anyway)"
      continue
    fi

    if [[ $unfree == true && $ALLOW_UNFREE != 1 ]]; then
      bad "$name is unfree and NIX_APPS_ALLOW_UNFREE=0"
      continue
    fi

    if ((!skip_check)); then
      info "Checking $name ($attr) for $SYSTEM"
      state=$(attr_state "$attr")
      case "$state" in
        ok) ok "$attr builds for $SYSTEM" ;;
        missing)
          bad "$attr does not exist in $FLAKE — search with: omarchy-nix search ${name%% *}"
          continue
          ;;
        error)
          # nixpkgs threw, and the throw is usually the answer: it names the
          # attribute that replaced this one.
          bad "$attr is in $FLAKE but refuses to evaluate:"
          warn "$(attr_error "$attr")"
          continue
          ;;
        unsupported)
          bad "$attr does not list $SYSTEM in meta.platforms — no build for this machine"
          [[ -n $note ]] && warn "$note"
          warn "Install anyway with: omarchy-nix install --no-check $id"
          continue
          ;;
        *) warn "could not evaluate $attr (offline?); attempting the install anyway" ;;
      esac
    fi

    refs+=("$FLAKE#$attr")
    labels+=("$name")
  done

  ((${#refs[@]})) || return 1

  info "Installing: ${labels[*]}"
  local env=()
  [[ $ALLOW_UNFREE == 1 ]] && env=(NIXPKGS_ALLOW_UNFREE=1)
  if env "${env[@]}" "$NIX" --extra-experimental-features "nix-command flakes" \
    profile add --impure "${refs[@]}"; then
    # A GUI app with no driver starts and dies, so wire graphics before
    # anything gets a chance to launch it.
    ensure_gl || true
    refresh_desktop_db
    ok "Installed: ${labels[*]}"
    notify -g "$GLYPH" "Nix apps installed" "${labels[*]}"
  else
    bad "install failed"
    notify -u critical -g "$GLYPH" "Nix install failed" "${labels[*]}"
    return 1
  fi
}

# ----------------------------------------------------------------- remove

cmd_remove() {
  ((${#@})) || die "nothing to remove (try: omarchy-nix menu remove)"
  require_nix

  local target row id name attr selector selectors=() labels=()
  for target in "$@"; do
    if row=$(resolve_app "$target"); then
      IFS=$'\t' read -r id name attr _ <<<"$row"
    else
      attr="$target"; name="$target"
    fi
    if selector=$(installed_attr "$attr"); then
      selectors+=("$selector")
      labels+=("$name")
    else
      warn "$name is not in the Nix profile"
    fi
  done

  ((${#selectors[@]})) || return 1

  if nixrun profile remove "${selectors[@]}"; then
    refresh_desktop_db
    ok "Removed: ${labels[*]}"
  else
    bad "remove failed"
    return 1
  fi
}

# ------------------------------------------------------------------- list

cmd_list() {
  require_nix
  local json=0
  [[ ${1:-} == --json ]] && json=1

  if ((json)); then
    profile_rows | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {name: .[0], attrPath: .[1], flake: .[2]})'
    return 0
  fi

  local name path url attr pretty count=0
  while IFS=$'\t' read -r name path url; do
    [[ -z $name ]] && continue
    attr="${path##*.}"
    pretty=$(jq -r --arg a "$attr" '[.apps[] | select(.attr == $a or (.attr | endswith("." + $a)))][0].name // ""' "$CATALOG" 2>/dev/null)
    printf '%s%-22s%s %-26s %s%s%s\n' \
      "$C_BOLD" "$name" "$C_RESET" \
      "${pretty:-$attr}" \
      "$C_DIM" "${url:-$FLAKE}#$attr" "$C_RESET"
    ((count++))
  done < <(profile_rows)

  ((count)) || echo "No apps installed in the Nix profile yet. Try: omarchy-nix menu"
}

# ----------------------------------------------------------------- status

cmd_status() {
  local brief=0 as_notification=0
  case "${1:-}" in
    --brief) brief=1 ;;
    --notify) as_notification=1 ;;
  esac

  if ((as_notification)); then
    local body
    body=$(cmd_status 2>&1)
    if command -v omarchy-notification-send >/dev/null 2>&1; then
      omarchy-notification-send -g "$GLYPH" "Nix apps" "$body"
    else
      printf '%s\n' "$body"
    fi
    return 0
  fi

  if ! find_nix; then
    ((brief)) && return 1
    echo "Nix is not installed. Run: omarchy-nix setup"
    return 1
  fi
  require_nix

  local count
  count=$(profile_rows | grep -c . || true)

  if ((brief)); then
    printf '%s\n' "$count"
    return 0
  fi

  printf '%s\n' "Nix: $("$NIX" --version 2>/dev/null | head -1)"
  printf '%s\n' "System: $SYSTEM   Flake: $FLAKE"
  printf '%s\n' "Apps in profile: $count"
  local store
  store=$(du -sh /nix/store 2>/dev/null | cut -f1)
  [[ -n $store ]] && printf '%s\n' "Store size: $store"
}

# ----------------------------------------------------------------- update

cmd_update() {
  require_nix
  if (($#)); then
    local target row attr selector selectors=()
    for target in "$@"; do
      if row=$(resolve_app "$target"); then
        IFS=$'\t' read -r _ _ attr _ <<<"$row"
      else
        attr="$target"
      fi
      selector=$(installed_attr "$attr") && selectors+=("$selector")
    done
    ((${#selectors[@]})) || die "none of those are installed"

    # `nix profile upgrade` follows the flake ref each element was installed
    # from, while `updates` measures against the configured one. Normally
    # those are the same. When they are not — someone changed
    # NIX_APPS_FLAKE, or installed by hand from a pin — the upgrade is a
    # no-op and the app stays listed as outdated forever. Say so, rather
    # than let it look like the upgrade silently failed.
    local sel url
    for sel in "${selectors[@]}"; do
      url=$(profile_rows | awk -F'\t' -v n="$sel" '$1 == n { print $3; exit }')
      [[ -z $url || $url == "$FLAKE" || $url == "flake:$FLAKE" ]] && continue
      warn "$sel was installed from $url, not $FLAKE — an upgrade follows the"
      warn "flake it came from. To move it: omarchy-nix remove $sel && omarchy-nix install $sel"
    done

    # Same flags as the --all branch below: without them an unfree app
    # refuses to upgrade, which is a confusing way to fail on VS Code.
    NIXPKGS_ALLOW_UNFREE=1 nixrun profile upgrade --impure "${selectors[@]}"
  else
    info "Upgrading every app in the Nix profile"
    NIXPKGS_ALLOW_UNFREE=1 nixrun profile upgrade --impure --all
  fi
  local rc=$?
  refresh_desktop_db
  if ((rc == 0)); then ok "Up to date"; else bad "upgrade failed"; fi
  return $rc
}

cmd_gc() {
  require_nix
  info "Dropping profile generations older than 30 days"
  nixrun profile wipe-history --older-than 30d
  info "Collecting garbage in the store (this can take a while)"
  nixrun store gc
  ok "Done. $(du -sh /nix/store 2>/dev/null | cut -f1) in /nix/store"
}

cmd_search() {
  (($#)) || die "usage: omarchy-nix search <query>"
  require_nix
  nixrun search "$FLAKE" "$@"
}

# ----------------------------------------------------------------- verify

cmd_verify() {
  require_nix
  local attrs expr out
  attrs=$(jq -r '[.apps[].attr] | map("\"" + . + "\"") | join(" ")' "$CATALOG")

  info "Evaluating ${FLAKE} for $SYSTEM — this takes a minute the first time"
  expr="
    let
      pkgs = $(nix_expr_pkgs);
      lib = pkgs.lib;
      SYSTEM = \"$SYSTEM\";
$(nix_expr_check)
    in builtins.listToAttrs (map (p: { name = p; value = check p; }) [ $attrs ])
  "

  out=$(nixrun eval --impure --json --expr "$expr") || die "evaluation failed"
  mkdir -p "$STATE_DIR"
  jq -n --argjson r "$out" --arg sys "$SYSTEM" --arg flake "$FLAKE" \
    '{system: $sys, flake: $flake, checkedAt: (now | todate), results: $r}' \
    >"$STATE_DIR/verified.json"

  jq -r --slurpfile cat <(jq '.' "$CATALOG") '
    to_entries[]
    | . as $e
    | ($cat[0].apps[] | select(.attr == $e.key)) as $app
    | "\($e.value)\t\($app.name)\t\($e.key)"' <<<"$out" |
    sort | while IFS=$'\t' read -r state name attr; do
      case "$state" in
        ok) ok "$name ${C_DIM}($attr)${C_RESET}" ;;
        unsupported) warn "$name — no $SYSTEM build ${C_DIM}($attr)${C_RESET}" ;;
        error)
          bad "$name — will not evaluate ${C_DIM}($attr)${C_RESET}"
          printf '      %s%s%s\n' "$C_DIM" "$(attr_error "$attr")" "$C_RESET"
          ;;
        missing) bad "$name — attr gone from nixpkgs ${C_DIM}($attr)${C_RESET}" ;;
      esac
    done

  echo
  info "Cached to $STATE_DIR/verified.json"
}

verified_state() {
  local attr="$1" f="$STATE_DIR/verified.json"
  [[ -r $f ]] || return 1
  jq -r --arg a "$attr" --arg s "$SYSTEM" '
    select(.system == $s) | .results[$a] // empty' "$f" 2>/dev/null
}

# ---------------------------------------------------------------- updates

# Which installed apps would change if you upgraded right now.
#
# Nix has no "check for updates" that stops short of doing the work, so this
# evaluates the current outPath for every installed attribute and compares it
# with the store path the profile actually holds. Evaluation is cheap next to
# a download, but it is not free, hence the cache: the bar widget reads the
# cache, and only a cache older than UPDATE_MAX_AGE triggers a fresh check.
compute_updates() {
  local names=() attrs=() paths=() name attrpath storepaths attr
  while IFS=$'\t' read -r name attrpath storepaths; do
    [[ -z $name ]] && continue
    attr=$(strip_attr_prefix "$attrpath")
    valid_attr "$attr" || continue
    names+=("$name")
    attrs+=("$attr")
    paths+=("$storepaths")
  done < <(profile_rows_detailed)

  if ((${#attrs[@]} == 0)); then
    jq -n --arg sys "$SYSTEM" --arg flake "$FLAKE" \
      '{system: $sys, flake: $flake, checkedAt: (now | todate), count: 0, outdated: []}'
    return 0
  fi

  local quoted="" a
  for a in "${attrs[@]}"; do quoted+="\"$a\" "; done

  local current
  current=$(nixrun eval --impure --json --expr "
    let
      pkgs = $(nix_expr_pkgs);
      lib = pkgs.lib;
      outPathOf = path:
        let probe = builtins.tryEval (lib.attrByPath (lib.splitString \".\" path) null pkgs);
        in if !probe.success || probe.value == null then null
           else let r = builtins.tryEval (toString probe.value.outPath);
                in if r.success then r.value else null;
    in builtins.listToAttrs (map (p: { name = p; value = outPathOf p; }) [ $quoted ])
  " 2>/dev/null) || return 1
  [[ -n $current ]] || return 1

  local outdated="[]" i want
  for i in "${!attrs[@]}"; do
    want=$(jq -r --arg a "${attrs[$i]}" '.[$a] // empty' <<<"$current")
    [[ -n $want ]] || continue
    # Already holding that exact store path? Then there is nothing to fetch.
    case ",${paths[$i]}," in
      *",$want,"*) continue ;;
    esac
    outdated=$(jq --arg n "${names[$i]}" --arg a "${attrs[$i]}" \
      '. + [{name: $n, attr: $a}]' <<<"$outdated")
  done

  jq -n --arg sys "$SYSTEM" --arg flake "$FLAKE" --argjson outdated "$outdated" \
    '{system: $sys, flake: $flake, checkedAt: (now | todate), count: ($outdated | length), outdated: $outdated}'
}

cache_age() {
  local file="$1" mtime now
  [[ -r $file ]] || { echo 999999999; return; }
  mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
  now=$(date +%s)
  echo $((now - mtime))
}

cmd_updates() {
  local brief=0 refresh=0 as_notification=0 max_age="$UPDATE_MAX_AGE"
  while (($#)); do
    case "$1" in
      --brief) brief=1; shift ;;
      --notify) as_notification=1; shift ;;
      --refresh) refresh=1; shift ;;
      --max-age) max_age="${2:-$UPDATE_MAX_AGE}"; shift 2 ;;
      -h | --help)
        echo "Usage: omarchy-nix updates [--brief] [--notify] [--refresh] [--max-age SECONDS]"
        return 0
        ;;
      *) die "unknown updates option: $1" ;;
    esac
  done

  if ((as_notification)); then
    local body
    body=$(cmd_updates 2>&1 | sed 's/\x1b\[[0-9;]*m//g')
    if command -v omarchy-notification-send >/dev/null 2>&1; then
      omarchy-notification-send -g "$GLYPH" "Nix apps" "$body"
    else
      printf '%s\n' "$body"
    fi
    return 0
  fi

  # No Nix, no answer — and for --brief a non-zero exit is how the bar widget
  # learns to stay hidden.
  find_nix || { ((brief)) || echo "Nix is not installed. Run: omarchy-nix setup"; return 1; }
  require_nix
  mkdir -p "$STATE_DIR"

  if ((refresh)) || [[ $(cache_age "$UPDATES_FILE") -gt $max_age ]]; then
    local fresh
    if fresh=$(compute_updates); then
      printf '%s\n' "$fresh" >"$UPDATES_FILE"
    elif [[ ! -r $UPDATES_FILE ]]; then
      ((brief)) || bad "could not check for updates (offline?)"
      return 1
    fi
  fi

  local count
  count=$(jq -r '.count // 0' "$UPDATES_FILE" 2>/dev/null || echo 0)

  if ((brief)); then
    printf '%s\n' "$count"
    # Exit non-zero when there is nothing to show, so a caller can treat
    # "no updates" and "no Nix" the same way.
    ((count > 0))
    return
  fi

  if ((count == 0)); then
    ok "Every Nix app is up to date"
    return 0
  fi

  info "$count update(s) available — run: omarchy-nix menu update"
  jq -r '.outdated[] | "  \(.name)  (\(.attr))"' "$UPDATES_FILE"
}

# ----------------------------------------------------------- nixpkgs index

# `pacman -Slq` is instant because the package list is already on disk. The
# nixpkgs equivalent has to be evaluated, so it gets built once and cached;
# after that the picker filters locally and feels the same.
#
# Two deliberate narrowings, both in service of "what can I actually install
# on this machine":
#
#   - only attributes whose meta.platforms covers $SYSTEM, and that are not
#     marked broken. On aarch64 `nix search` happily lists Spotify and Slack
#     even though upstream ships x86_64 binaries only; those belong in the
#     catalogue's `unavailable` list, not in a picker that offers to install
#     them. On x86_64 the same filter simply lets more through.
#   - only top-level attributes. python3Packages.* and friends are libraries,
#     not apps, and dropping them takes the list from ~112k rows to ~22k.
#
# `omarchy-nix search` still goes straight to `nix search`, so nothing is
# actually out of reach.
ensure_index() {
  local force="${1:-0}"
  mkdir -p "$STATE_DIR"
  if ((!force)) && [[ -s $INDEX_FILE ]] && [[ $(cache_age "$INDEX_FILE") -le $INDEX_MAX_AGE ]]; then
    return 0
  fi

  info "Indexing $FLAKE packages that build for $SYSTEM (seconds, once nixpkgs is fetched)"
  local tmp
  tmp=$(mktemp)
  if ! nixrun eval --impure --json --expr "
    let
      pkgs = $(nix_expr_pkgs);
      lib = pkgs.lib;
      probe = name:
        let r = builtins.tryEval (
          let v = pkgs.\${name}; in
          if !(lib.isDerivation v) then null
          else let m = v.meta or {}; in
            if (m.broken or false) then null
            else if !(builtins.elem \"$SYSTEM\" (m.platforms or [])) then null
            else { inherit name; version = v.version or \"\"; description = m.description or \"\"; }
        );
        in if r.success then r.value else null;
    in builtins.filter (x: x != null) (map probe (builtins.attrNames pkgs))
  " 2>/dev/null |
    jq -r '.[] | [.name, .version, ((.description // "") | gsub("\\s+"; " "))] | @tsv' >"$tmp"; then
    rm -f "$tmp"
    bad "could not build the index"
    return 1
  fi

  if [[ ! -s $tmp ]]; then
    rm -f "$tmp"
    bad "the index came back empty"
    return 1
  fi

  sort -o "$tmp" "$tmp"
  mv "$tmp" "$INDEX_FILE"
  ok "$(wc -l <"$INDEX_FILE") packages build for $SYSTEM"
}

index_lines() {
  [[ -s $INDEX_FILE ]] || return 1
  awk -F'\t' '{ printf "%-42s %-14s %s\n", $1, $2, $3 }' "$INDEX_FILE"
}

index_count() {
  [[ -s $INDEX_FILE ]] && wc -l <"$INDEX_FILE" || echo 0
}

cmd_index() {
  # --print is what fzf reloads from. It builds only when there is nothing to
  # read at all — a stale index still prints, because a picker that freezes
  # for a minute on a keypress is worse than one showing last week's list.
  if [[ ${1:-} == --print ]]; then
    if [[ ! -s $INDEX_FILE ]]; then
      require_nix
      ensure_index >&2 || return 1
    fi
    index_lines
    return
  fi
  require_nix
  local force=0
  [[ ${1:-} == --refresh ]] && force=1
  ensure_index "$force"
}

# Preview pane for the picker: everything here comes off the cached index,
# the catalogue and pacman, so it stays instant while fzf redraws.
cmd_info() {
  local attr="${1:-}"
  [[ -n $attr ]] || return 0

  local line version description
  line=$(awk -F'\t' -v a="$attr" '$1 == a { print; exit }' "$INDEX_FILE" 2>/dev/null)
  IFS=$'\t' read -r _ version description <<<"$line"

  printf '%s%s%s\n' "$C_BOLD" "$attr" "$C_RESET"
  [[ -n ${version:-} ]] && printf '  version      %s\n' "$version"
  [[ -n ${description:-} ]] && printf '  description  %s\n' "$description"

  local app
  app=$(jq -r --arg a "$attr" '[.apps[] | select(.attr == $a)][0] // empty' "$CATALOG" 2>/dev/null)
  if [[ -n $app ]]; then
    printf '  catalogue    %s (%s)%s\n' \
      "$(jq -r '.name' <<<"$app")" "$(jq -r '.category' <<<"$app")" \
      "$([[ $(jq -r '.unfree // false' <<<"$app") == true ]] && echo ", unfree")"
  fi

  # The index is already filtered to what builds here, so a hit in it is the
  # strongest answer available; verified.json only covers the catalogue.
  local state
  if [[ -n $line ]]; then
    printf '  platform     builds for %s\n' "$SYSTEM"
  else
    state=$(verified_state "$attr" 2>/dev/null || true)
    case "$state" in
      ok) printf '  platform     builds for %s\n' "$SYSTEM" ;;
      unsupported) printf '  platform     %sno %s build%s\n' "$C_YELLOW" "$SYSTEM" "$C_RESET" ;;
      error) printf '  platform     %srenamed or removed upstream — omarchy-nix verify says how%s\n' "$C_RED" "$C_RESET" ;;
      missing) printf '  platform     %sattribute not in %s%s\n' "$C_RED" "$FLAKE" "$C_RESET" ;;
      *) [[ -s $INDEX_FILE ]] && printf '  platform     %snot among the %s packages that build for %s%s\n' \
        "$C_YELLOW" "$(index_count)" "$SYSTEM" "$C_RESET" ;;
    esac
  fi

  local arch_pkg
  arch_pkg=$(jq -r --arg a "$attr" '[.apps[] | select(.attr == $a)][0].arch // empty' "$CATALOG" 2>/dev/null)
  arch_pkg="${arch_pkg:-$attr}"
  if pacman -Si "$arch_pkg" &>/dev/null; then
    printf '  %sarch repos   %s is packaged natively — prefer: omarchy pkg add %s%s\n' \
      "$C_YELLOW" "$arch_pkg" "$arch_pkg" "$C_RESET"
  fi

  local hint
  hint=$(unavailable_note "$attr")
  if [[ -n $hint ]]; then
    printf '  %sknown gap    %s%s\n' "$C_YELLOW" "$hint" "$C_RESET"
  fi

  printf '\n  install with omarchy-nix install %s\n' "$attr"
}

# ------------------------------------------------------------ fzf pickers

fzf_pick() {
  # Same keys and colours as omarchy-pkg-install, so the muscle memory carries.
  local header="$1" query="${2:-}"
  shift 2 2>/dev/null || shift $#
  fzf \
    --multi \
    --preview 'omarchy-nix info {1}' \
    --preview-label='alt-p: toggle preview, alt-j/k: scroll, tab: multi-select' \
    --preview-label-pos='bottom' \
    --preview-window 'down:65%:wrap' \
    --bind 'alt-p:toggle-preview' \
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
    --bind 'alt-k:preview-up,alt-j:preview-down' \
    --color 'pointer:green,marker:green' \
    --header "$header" \
    --query "$query" \
    "$@"
}

cmd_pick() {
  require_nix
  interactive || die "the picker needs a terminal"
  command -v fzf >/dev/null 2>&1 || die "fzf is required for the picker"
  ensure_index || return 1

  local selection attrs=()
  selection=$(index_lines |
    fzf_pick "Every package that builds for $SYSTEM — enter to install, tab for several" \
      "${*:-}" --prompt "All $(index_count) for $SYSTEM > ") || return 0
  [[ -n $selection ]] || return 0

  while read -r line; do
    [[ -z $line ]] && continue
    attrs+=("$(awk '{print $1}' <<<"$line")")
  done <<<"$selection"

  cmd_install "${attrs[@]}"
}

# ------------------------------------------------------------------- menu

# The curated catalogue as picker rows. Also reachable as `menu --print`,
# which is what the picker reloads from when you toggle back out of the full
# package list.
catalog_lines() {
  local -A installed=()
  local name path
  while IFS=$'\t' read -r name path _; do
    [[ -n $path ]] && installed["$(strip_attr_prefix "$path")"]=1
  done < <(profile_rows)

  local id app_name attr category unfree state marker
  while IFS=$'\t' read -r id app_name attr category unfree; do
    if [[ -n ${installed[$attr]:-} ]]; then
      marker="installed"
    else
      state=$(verified_state "$attr" || true)
      case "$state" in
        unsupported) marker="no $SYSTEM build" ;;
        error) marker="renamed upstream" ;;
        missing) marker="attr gone" ;;
        *) marker="" ;;
      esac
    fi
    [[ $unfree == true ]] && app_name="$app_name (unfree)"
    printf '%-28s %-28s %-14s %s\n' "$attr" "$app_name" "$category" "$marker"
  done < <(jq -r '.apps[] | [.id, .name, .attr, .category, ((.unfree // false) | tostring)] | @tsv' "$CATALOG")
}

cmd_menu() {
  local mode="${1:-install}"

  if [[ $mode == --print ]]; then
    require_nix
    catalog_lines
    return
  fi

  interactive || die "the picker needs a terminal (run it from the Omarchy menu)"
  command -v fzf >/dev/null 2>&1 || die "fzf is required for the picker"

  if ! find_nix; then
    info "Nix is not installed yet."
    confirm "Run omarchy-nix setup first?" || return 1
    cmd_setup || return 1
  fi
  require_nix

  if [[ $mode == update ]]; then
    # Ask nixpkgs rather than trusting the cache: the bar widget is what
    # usually opens this, and the answer it is showing may be hours old.
    cmd_updates --refresh >/dev/null 2>&1 || true
    local count
    count=$(jq -r '.count // 0' "$UPDATES_FILE" 2>/dev/null || echo 0)
    if ((count == 0)); then
      ok "Every Nix app is up to date"
      notify_widget
      return 0
    fi

    # Version comes from the package list when it has one; it is the single
    # most useful thing to see next to "this would change".
    local rows selection attrs=()
    rows=$(jq -r '.outdated[] | [.name, .attr] | @tsv' "$UPDATES_FILE" |
      while IFS=$'\t' read -r uname uattr; do
        printf '%-28s %-24s %s\n' "$uattr" "$uname" \
          "$(awk -F'\t' -v a="$uattr" '$1 == a { print $2; exit }' "$INDEX_FILE" 2>/dev/null)"
      done)
    [[ -n $rows ]] || { ok "Every Nix app is up to date"; return 0; }

    selection=$(printf '%s\n' "$rows" |
      fzf_pick "$count Nix app update(s) — space to select, enter to upgrade" "" \
        --prompt "Update > " --bind 'space:toggle' --bind 'ctrl-a:select-all') || return 0
    [[ -n $selection ]] || return 0

    while read -r line; do
      [[ -z $line ]] && continue
      attrs+=("$(awk '{print $1}' <<<"$line")")
    done <<<"$selection"

    cmd_update "${attrs[@]}"
    local rc=$?
    cmd_updates --refresh >/dev/null 2>&1 || true
    notify_widget
    return $rc
  fi

  if [[ $mode == remove ]]; then
    local rows selection names=()
    rows=$(profile_rows_detailed | awk -F'\t' '{ n = $2; sub(/.*\./, "", n); printf "%-30s %s\n", $1, n }')
    [[ -n $rows ]] || die "nothing installed in the Nix profile"
    selection=$(printf '%s\n' "$rows" | fzf_pick "Remove from the Nix profile — tab for several") || return 0
    [[ -n $selection ]] || return 0
    while read -r line; do
      [[ -z $line ]] && continue
      names+=("$(awk '{print $1}' <<<"$line")")
    done <<<"$selection"
    cmd_remove "${names[@]}"
    return
  fi

  # alt-a flips the same picker between the ~50 curated apps and every
  # package that builds for this machine, and back. Which list you are in is
  # read off the prompt, so fzf itself carries the state and this stays one
  # binding rather than two half-modes.
  local n
  n=$(index_count)
  local prompt_curated="Curated > " prompt_all
  if ((n > 0)); then
    prompt_all="All $n for $SYSTEM > "
  else
    prompt_all="All packages for $SYSTEM > "
  fi

  local toggle="alt-a:transform:case \$FZF_PROMPT in Curated*) echo 'change-prompt($prompt_all)+reload(omarchy-nix index --print)';; *) echo 'change-prompt($prompt_curated)+reload(omarchy-nix menu --print)';; esac"

  local header="Curated apps for $SYSTEM — enter to install, tab for several, alt-a for every package that builds here"
  ((n > 0)) || header+=" (first alt-a builds that list)"

  local selection attrs=()
  selection=$(catalog_lines |
    fzf_pick "$header" "" --prompt "$prompt_curated" --bind "$toggle") || return 0
  [[ -n $selection ]] || return 0

  while read -r line; do
    [[ -z $line ]] && continue
    attrs+=("$(awk '{print $1}' <<<"$line")")
  done <<<"$selection"

  cmd_install "${attrs[@]}"
}
# ----------------------------------------------------------------- doctor

cmd_doctor() {
  local problems=0

  info "Architecture"
  printf '    %s (%s)\n' "$(uname -m)" "$SYSTEM"
  if [[ $SYSTEM == x86_64-linux ]]; then
    warn "on x86_64 the Arch repos and the AUR cover most of this catalogue — prefer omarchy pkg add"
    warn "everything here still works; it is just needed less often"
  fi

  info "Nix"
  if find_nix; then
    ok "$NIX — $("$NIX" --version 2>/dev/null | head -1)"
  else
    bad "not installed — run: omarchy-nix setup"
    ((problems++))
  fi

  if find_nix; then
    require_nix
    if systemctl is-active --quiet nix-daemon.service 2>/dev/null ||
      systemctl is-active --quiet determinate-nixd.socket 2>/dev/null ||
      systemctl is-active --quiet nix-daemon.socket 2>/dev/null; then
      ok "nix-daemon is running"
    else
      bad "nix-daemon is not active"
      ((problems++))
    fi

    if nixrun eval --expr '1 + 1' >/dev/null 2>&1; then
      ok "flakes / nix-command usable"
    else
      bad "cannot evaluate — experimental features may be off"
      ((problems++))
    fi
  fi

  info "Desktop integration"
  local apps_dir="$HOME/.nix-profile/share/applications"
  if [[ -d $apps_dir ]]; then
    ok "$(find -L "$apps_dir" -name '*.desktop' 2>/dev/null | wc -l) .desktop files in the Nix profile"
  else
    warn "no .desktop files yet (nothing installed)"
  fi

  if [[ -f $ENV_FILE ]]; then
    ok "session env file present: $ENV_FILE"
  else
    bad "missing $ENV_FILE — run: omarchy-nix setup --env-only"
    ((problems++))
  fi

  case ":${XDG_DATA_DIRS:-}:" in
    *":$HOME/.nix-profile/share:"*) ok "XDG_DATA_DIRS includes the Nix profile" ;;
    *)
      warn "this session's XDG_DATA_DIRS does not include ~/.nix-profile/share"
      warn "log out and back in — uwsm only reads env.d at session start"
      ;;
  esac

  # The mirrored copies are what the launcher actually reads: it watches this
  # directory, and never notices a new profile generation on its own.
  local mirrored=0 profile_entries=0
  mirrored=$(grep -l '^X-Omarchy-Nix=true$' "$DESKTOP_DIR"/*.desktop 2>/dev/null | wc -l)
  [[ -d $apps_dir ]] && profile_entries=$(find -L "$apps_dir" -name '*.desktop' 2>/dev/null | wc -l)
  if ((profile_entries == mirrored)); then
    ok "$mirrored entr(ies) mirrored into $DESKTOP_DIR"
  else
    warn "$mirrored of $profile_entries entries mirrored — run: omarchy-nix sync"
  fi

  info "Graphics"
  if gl_ready; then
    ok "driver: $(readlink -f "$GL_PROFILE" 2>/dev/null)"
    if grep -q '^LIBGL_ALWAYS_SOFTWARE=1$' "$GL_ENV_FILE" 2>/dev/null; then
      warn "software rendering — this machine's driver offers no OpenGL 3.2"
      warn "core context, and GTK apps come up black without it"
    elif [[ -r $GL_ENV_FILE ]]; then
      ok "$(sed -n 's/^# //p' "$GL_ENV_FILE" | head -1)"
    else
      warn "renderer not probed yet — run: omarchy-nix gl --probe"
    fi
  else
    warn "no driver yet — nixpkgs GUI apps will fail with \"No provider of"
    warn "eglGetPlatformDisplayEXT found\". Fix with: omarchy-nix gl"
  fi

  info "Tooling"
  local t
  for t in jq fzf gum curl pacman; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t"; else bad "$t missing"; ((problems++)); fi
  done

  info "Package list"
  if [[ -s $INDEX_FILE ]]; then
    local age=$(( $(cache_age "$INDEX_FILE") / 86400 ))
    ok "$(index_count) packages build for $SYSTEM (indexed ${age}d ago)"
    ((age * 86400 > INDEX_MAX_AGE)) && warn "stale — refresh with: omarchy-nix index --refresh"
  else
    warn "not built yet — omarchy-nix index, or alt-a in the picker"
  fi

  echo
  if ((problems)); then
    bad "$problems problem(s) found"
    return 1
  fi
  ok "Everything looks good"
}

cmd_catalog() {
  if [[ ${1:-} == --json ]]; then
    cat "$CATALOG"
    return 0
  fi
  jq -r '.apps[] | [.category, .name, .id, .attr] | @tsv' "$CATALOG" |
    sort | awk -F'\t' '{ if ($1 != last) { print ""; print "  " toupper($1); last = $1 } printf "    %-26s %-16s %s\n", $2, $3, $4 }'
  unavailable_here || return 0
  echo
  echo "  NOT AVAILABLE ON $SYSTEM (upstream ships x86_64 only)"
  jq -r '.unavailable.entries[]? | "    \(.name) — \(.why); try: \(.instead)"' "$CATALOG"
}

usage() {
  cat <<EOS
${C_BOLD}omarchy-nix${C_RESET} — big desktop apps from nixpkgs, for architectures Arch does not cover

  ${C_BOLD}setup${C_RESET} [--env-only]        Install Determinate Nix and wire it into the session
  ${C_BOLD}menu${C_RESET} [remove|update]      Pick from the curated catalogue (or remove, or upgrade)
  ${C_BOLD}pick${C_RESET} [query]              Pick straight from every package that builds for $SYSTEM
  ${C_BOLD}install${C_RESET} <app|attr>...     Install by catalogue id, name, or nixpkgs attribute
      --force                 install even when a native Arch package exists
      --no-check              skip the meta.platforms check
  ${C_BOLD}remove${C_RESET} <app>...           Remove from the Nix profile
  ${C_BOLD}list${C_RESET} [--json]             What is installed in the Nix profile
  ${C_BOLD}update${C_RESET} [app...]           Upgrade everything, or just these
  ${C_BOLD}exec${C_RESET} <command> [args]     Run a Nix app with the graphics driver wired up
  ${C_BOLD}gl${C_RESET} [--refresh|--probe]    Install or update that driver, or re-probe the renderer
  ${C_BOLD}sync${C_RESET}                      Re-mirror the Nix desktop entries into the launcher
  ${C_BOLD}search${C_RESET} <query>            Search nixpkgs
  ${C_BOLD}catalog${C_RESET} [--json]          Show the curated app catalogue
  ${C_BOLD}verify${C_RESET}                    Check every catalogue entry against $SYSTEM and cache it
  ${C_BOLD}updates${C_RESET} [--brief]         What would change on an upgrade (cached; --refresh forces)
  ${C_BOLD}index${C_RESET} [--refresh]         Rebuild the list of packages that build for $SYSTEM
  ${C_BOLD}status${C_RESET} [--brief]          Profile summary (--brief prints the app count)
  ${C_BOLD}doctor${C_RESET}                    Diagnose the Nix + Omarchy integration
  ${C_BOLD}gc${C_RESET}                        Trim old generations and collect garbage

Config: $CONFIG_FILE
Catalogue: $CATALOG
EOS
}

main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    install | add) cmd_install "$@" ;;
    remove | rm | uninstall) cmd_remove "$@" ;;
    list | ls) cmd_list "$@" ;;
    update | upgrade) cmd_update "$@" ;;
    search) cmd_search "$@" ;;
    catalog | catalogue) cmd_catalog "$@" ;;
    verify) cmd_verify "$@" ;;
    status) cmd_status "$@" ;;
    doctor) cmd_doctor "$@" ;;
    gc) cmd_gc "$@" ;;
    menu) cmd_menu "$@" ;;
    pick | browse) cmd_pick "$@" ;;
    updates) cmd_updates "$@" ;;
    exec) cmd_exec "$@" ;;
    gl) cmd_gl "$@" ;;
    sync) require_nix; sync_desktop_entries && ok "Desktop entries synced to $DESKTOP_DIR" ;;
    index) cmd_index "$@" ;;
    info) cmd_info "$@" ;;
    help | -h | --help) usage ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
